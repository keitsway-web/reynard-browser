CURRENT_VERSION = 0.9.0
CURRENT_BUILD = UNKNOWN

IPHONEOS_DEPLOYMENT_TARGET = 13.0
ARCHS = arm64
VALID_ARCHS = arm64

ENABLE_BITCODE = NO

GECKO_DIST = $(SRCROOT)/../engine/firefox/obj-aarch64-apple-ios/dist

HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT) $(SRCROOT)/GeckoView $(SRCROOT)/GeckoView/** $(SRCROOT)/Reynard $(SRCROOT)/Reynard/** $(SRCROOT)/Helper $(SRCROOT)/Helper/** $(GECKO_DIST)/include $(GECKO_DIST)/include/GeckoView
USER_HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT) $(SRCROOT)/**
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT) $(GECKO_DIST)/include
LIBRARY_SEARCH_PATHS = $(inherited) $(GECKO_DIST)/bin $(GECKO_DIST)/lib
FRAMEWORK_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Reynard/Bridging/Reynard-Bridging-Header.h

CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = 
DEVELOPMENT_TEAM = 
PROVISIONING_PROFILE_SPECIFIER = 


